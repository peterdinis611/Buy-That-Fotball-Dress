{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ClientApps": [
    "http://localhost:3000",
    "http://127.0.0.1:3000"
  ],
  "ReverseProxy": {
    "Routes": {
      "auctionBids": {
        "ClusterId": "bids",
        "Match": {
          "Path": "/api/auctions/{auctionId}/bids",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/bids/{auctionId}" }
        ]
      },
      "bids": {
        "ClusterId": "bids",
        "Match": {
          "Path": "/api/bids/{**catch-all}"
        }
      },
      "settlements": {
        "ClusterId": "settlements",
        "Match": {
          "Path": "/api/settlements/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "auctions": {
        "ClusterId": "auctions",
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        }
      },
      "search": {
        "ClusterId": "search",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "admin": {
        "ClusterId": "admin",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auctions": {
        "Destinations": {
          "auctionApi": {
            "Address": "http://localhost:5025"
          }
        }
      },
      "search": {
        "Destinations": {
          "searchApi": {
            "Address": "http://localhost:5026"
          }
        }
      },
      "identity": {
        "Destinations": {
          "identityApi": {
            "Address": "http://localhost:5028"
          }
        }
      },
      "bids": {
        "Destinations": {
          "bidApi": {
            "Address": "http://localhost:5029"
          }
        }
      },
      "settlements": {
        "Destinations": {
          "settlementApi": {
            "Address": "http://localhost:5031"
          }
        }
      },
      "payments": {
        "Destinations": {
          "paymentApi": {
            "Address": "http://localhost:5034"
          }
        }
      },
      "admin": {
        "Destinations": {
          "adminApi": {
            "Address": "http://localhost:5033"
          }
        }
      },
      "notifications": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "notificationApi": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  }
}
