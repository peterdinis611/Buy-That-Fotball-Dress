{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ClientApps": [
    "http://localhost:3000"
  ],
  "ReverseProxy": {
    "Routes": {
      "auctionBids": {
        "ClusterId": "bids",
        "Match": {
          "Path": "/api/auctions/{auctionId}/bids",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/bids/{auctionId}" }
        ]
      },
      "bids": {
        "ClusterId": "bids",
        "Match": {
          "Path": "/api/bids/{**catch-all}"
        }
      },
      "auctions": {
        "ClusterId": "auctions",
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        }
      },
      "search": {
        "ClusterId": "search",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auctions": {
        "Destinations": {
          "auctionApi": {
            "Address": "http://localhost:5025"
          }
        }
      },
      "search": {
        "Destinations": {
          "searchApi": {
            "Address": "http://localhost:5026"
          }
        }
      },
      "identity": {
        "Destinations": {
          "identityApi": {
            "Address": "http://localhost:5028"
          }
        }
      },
      "bids": {
        "Destinations": {
          "bidApi": {
            "Address": "http://localhost:5029"
          }
        }
      }
    }
  }
}
